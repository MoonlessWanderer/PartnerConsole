# Partner Console 1.0.4 API settings for this install folder.
# bash install.sh copies this to config/api.env and fills the signing keys.
# Keep config/api.env mode 600. Do not commit it.
# Values are a single token: no spaces, quotes, or #.
# Percent-encode reserved characters in DATABASE_URL.
# Do not put ADMIN_PASSWORD here. scripts/bootstrap.sh asks for it and forgets it.
# A database stored inside this install:
# DATABASE_URL=sqlite:////ABSOLUTE/INSTALL/PATH/data/partnerconsole.db

ENVIRONMENT=production
DATABASE_URL=mysql+pymysql://partnerconsole:REPLACE_WITH_PASSWORD@127.0.0.1:3306/partnerconsole?charset=utf8mb4
SECRET_KEY=REPLACE_WITH_RANDOM
ADMIN_JWT_SECRET=REPLACE_WITH_RANDOM
PARTNER_JWT_SECRET=REPLACE_WITH_RANDOM
# Optional. If set, keep the same value for the life of the stored panel secrets.
PANEL_ENCRYPTION_KEY=
ADMIN_USERNAME=admin
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=REPLACE_WITH_HTTPS_ORIGIN
API_RATE_LIMIT_PER_MINUTE=120
# Exact scheme://host:port entries, comma-separated. Empty unless a panel is loopback or private.
PANEL_PRIVATE_ORIGINS=

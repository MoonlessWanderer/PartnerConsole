DATABASE_URL=sqlite:///./data/partner.db
# Development target: MySQL 8.4 LTS / InnoDB (requires approved isolated setup).
# Example only; do not replace the development URL until that setup is approved:
# DATABASE_URL=mysql+pymysql://TEST_USER:ENCODED_PASSWORD@127.0.0.1:3307/partnerpanel_test_wp1?charset=utf8mb4
# Required: independently generated random secret, at least 32 characters.
SECRET_KEY=
ADMIN_JWT_SECRET=
PARTNER_JWT_SECRET=
# Optional: independent random encryption key. Keep existing deployments' key unchanged.
PANEL_ENCRYPTION_KEY=
ADMIN_USERNAME=admin
# Required only for first bootstrap: a non-default password of 12-200 characters.
ADMIN_PASSWORD=
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:3741,http://127.0.0.1:3741

ENVIRONMENT=development
API_RATE_LIMIT_PER_MINUTE=120
# Exact origins only, for explicitly authorized internal/loopback panels.
# Example for the test lab: http://127.0.0.1:8788
PANEL_PRIVATE_ORIGINS=
